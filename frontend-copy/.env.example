# Copy this file to .env and adjust as needed. Vite only reads variables
# prefixed VITE_. See src/config/backend.js — the WebSocket URL and video
# feed URL are both derived automatically from this one value.

VITE_API_BASE_URL=http://localhost:8000

# For phone GPS / LAN testing, point this at the machine actually running
# the backend instead of localhost, e.g.:
# VITE_API_BASE_URL=http://192.168.1.50:8000
#
# When testing camera/geolocation from a phone over the LAN, the frontend
# itself must also be served over HTTPS (browsers only allow camera/location
# access from "secure contexts"). The Vite dev server automatically picks up
# the certificate the backend already generates at
# backend_copy/.runtime/phone_gps_cert.pem — nothing to configure here.
# If your backend project lives somewhere other than the default sibling
# `backend_copy` folder, point Vite at it instead:
# VITE_SSL_CERT_DIR=/path/to/backend_copy/.runtime
